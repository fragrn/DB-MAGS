      "actions": [
        {
          "kind": "logical_backup_command",
          "database": "tpcc_10W",
          "command": [
            "mysqldump",
            "--user=root",
            "--host=127.0.0.1",
            "--protocol=tcp",
            "--port=3306",
            "--lock-tables",
            "--no-tablespaces",
            "--set-gtid-purged=OFF",
            "--where=OL_O_ID<=100000",
            "--result-file=/tmp/backup_tpcc_10W_order_line_part.sql",
            "tpcc_10W",
            "order_line"
          ],
          "duration_sec": 15,
          "output_path": "/tmp/backup_tpcc_10W_order_line_part.sql"
        }
      ],
      "expected_metrics": {
        "db": {
          "Threads_running": "increase",
          "Innodb_row_lock_waits": "increase",
          "processlist_blocking_states": [
            "Locked",
            "Waiting for table metadata lock"
          ]
        },
        "os": {
          "disk_io_write_bytes": "increase"
        },
        "edges": [
          "backup->maintenance_conflict",
          "backup->lock_contention"
        ]
      },
