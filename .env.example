# OpenAI settings
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PLANNER_TEMPERATURE=0.2
OPENAI_SQL_TEMPERATURE=0.1
ENABLE_OPENAI_PLANNER=1
ENABLE_OPENAI_SQL=1

# Agent runtime settings
DBMAGS_DEFAULT_DATABASE=tpcc10_test
DBMAGS_MAX_CONCURRENCY=3

# Database connection settings
DBMAGS_SERVER_ADDRESS=127.0.0.1
DBMAGS_SERVER_USERNAME=root
DBMAGS_SERVER_PASSWORD=
DBMAGS_MYSQL_HOST=127.0.0.1
DBMAGS_MYSQL_PORT=3306
DBMAGS_MYSQL_USER=root
DBMAGS_MYSQL_PASSWORD=
DBMAGS_MYSQL_DB=tpcc10_test
DBMAGS_BENCHBASE_JAR_PATH=.tools/benchbase-main/target/benchbase-mysql/benchbase.jar
DBMAGS_BENCHBASE_JAVA_BIN=/opt/homebrew/opt/openjdk/bin/java
DBMAGS_CHAOSBLADE_PATH=.tools/chaosblade-1.8.0-darwin_arm64/blade
