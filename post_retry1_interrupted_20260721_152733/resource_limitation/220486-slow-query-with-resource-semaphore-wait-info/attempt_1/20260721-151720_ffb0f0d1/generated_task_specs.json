              "concurrency": 1,
              "steps": [
                {
                  "sql": "INSERT INTO reference_table (id, status, description) SELECT n, MOD(n, 5), CONCAT('Description_', n) FROM (SELECT TOP 100 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n FROM sys.all_objects) AS numbers"
                },
                {
                  "sql": "INSERT INTO workload_table (id, category, value, payload) SELECT n, CASE WHEN MOD(n, 1000) = 0 THEN 'high' ELSE 'low' END, n % 100, REPLICATE(CAST('A' AS NVARCHAR(MAX)), 100) FROM (SELECT TOP 10000 ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n FROM sys.all_objects) AS numbers"
